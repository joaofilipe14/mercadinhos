        {
          "name": "1.2 Login Câmara (Auto-Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.token) {",
                  "    pm.collectionVariables.set(\"camara_token\", jsonData.token);",
                  "    console.log(\"Token da Câmara guardado com sucesso!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
